# Supabase Dashboard > Project Settings > API から取得します。
# 公開可能な値だけをEXPO_PUBLIC_へ設定してください。
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# service_role / secret key はアプリやEXPO_PUBLIC_へ絶対に入れないでください。

# 規約・ストア表示に使う公開情報です。個人のGitメールを流用せず、
# 公開専用のサポートアドレスを用意してください。
EXPO_PUBLIC_OPERATOR_NAME=運営者の正式名称
EXPO_PUBLIC_SUPPORT_EMAIL=support@YOUR_DOMAIN
EXPO_PUBLIC_PUBLIC_BASE_URL=https://YOUR_DOMAIN

# Android版の地図表示に必要です。Google CloudでMaps SDK for Androidを有効化し、
# com.shuwa.tsudowa とリリース署名SHA-1に制限したキーを設定してください。
# この値はアプリへ組み込まれるため、API制限とアプリ制限が必須です。
GOOGLE_MAPS_API_KEY=YOUR_RESTRICTED_ANDROID_MAPS_KEY

# J-PlatPat等で正式名称の調査・採用判断を終えた後にtrueへ変更します。
RELEASE_BRAND_APPROVED=false

# 提供予定国のプライバシー・UGC・消費者保護要件について、
# 運営体制と専門家確認を終えた後にtrueへ変更します。
RELEASE_GLOBAL_COMPLIANCE_APPROVED=false
