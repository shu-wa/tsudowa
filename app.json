{
  "expo": {
    "name": "Do Eventer",
    "slug": "do-eventer",
    "version": "0.12.0",
    "orientation": "portrait",
    "icon": "./assets/images/brand-icon.png",
    "scheme": "do-eventer",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5F3EC",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.shuwa.doeventer",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F5F3EC",
        "foregroundImage": "./assets/images/brand-icon-foreground.png",
        "monochromeImage": "./assets/images/brand-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.shuwa.doeventer",
      "versionCode": 1
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/brand-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/brand-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F5F3EC",
          "dark": {
            "backgroundColor": "#F5F3EC"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "招待QRコードを読み取るためにカメラを使用します。",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "イベント予定を端末カレンダーへ追加するために使用します。"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "イベント場所を現在地から探すために位置情報を使用します。"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#285943",
          "defaultChannel": "event-reminders"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
