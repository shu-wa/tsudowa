{
  "name": "tsudowa",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "packageManager": "pnpm@10.34.5",
  "expo": {
    "install": {
      "exclude": [
        "react-native-reanimated"
      ]
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "web:preview": "expo export --platform web && node scripts/serve-web.js",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "check:dates": "node scripts/date-regression-check.mjs",
    "check:times": "node scripts/time-regression-check.mjs",
    "check:onboarding": "node scripts/onboarding-regression-check.mjs",
    "check:storage": "node scripts/storage-regression-check.mjs",
    "export:web": "expo export --platform web",
    "release:check": "node --env-file=.env ./scripts/release-check.js",
    "release:verify": "pnpm check:dates && pnpm check:times && pnpm check:onboarding && pnpm check:storage && pnpm typecheck && pnpm lint && pnpm export:web && pnpm release:check"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "^2.110.7",
    "expo": "~57.0.10",
    "expo-calendar": "~57.0.1",
    "expo-camera": "~57.0.3",
    "expo-constants": "~57.0.9",
    "expo-crypto": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.2",
    "expo-image-picker": "~57.0.7",
    "expo-linking": "~57.0.5",
    "expo-location": "~57.0.7",
    "expo-notifications": "~57.0.8",
    "expo-router": "~57.0.10",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~3.1.0",
    "react-native-maps": "1.29.0",
    "react-native-reanimated": "~4.5.3",
    "react-native-safe-area-context": "~5.8.1",
    "react-native-screens": "~4.26.2",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.18",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "expo-doctor": "1.20.1",
    "typescript": "~5.9.2"
  },
  "private": true
}
