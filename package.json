{
  "name": "tsudowa",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "packageManager": "pnpm@10.34.5",
  "expo": {
    "install": {
      "exclude": [
        "react-native-reanimated"
      ]
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "web:preview": "expo export --platform web && node scripts/serve-web.js",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "check:dates": "node scripts/date-regression-check.mjs",
    "check:times": "node scripts/time-regression-check.mjs",
    "check:onboarding": "node scripts/onboarding-regression-check.mjs",
    "check:storage": "node scripts/storage-regression-check.mjs",
    "check:auth-redirect": "node scripts/auth-redirect-regression-check.mjs",
    "check:auth-flow": "node scripts/auth-flow-regression-check.mjs",
    "check:profile-handle": "node scripts/profile-handle-regression-check.mjs",
    "check:collections": "node scripts/collection-regression-check.mjs",
    "check:chat": "node scripts/chat-regression-check.mjs",
    "check:groups-notifications": "node scripts/groups-notifications-regression-check.mjs",
    "check:event-creation": "node scripts/event-creation-regression-check.mjs",
    "check:event-fetch": "node scripts/event-fetch-regression-check.mjs",
    "check:remote": "node --env-file=.env.local scripts/remote-security-smoke.mjs",
    "export:web": "expo export --platform web",
    "release:check": "node --env-file=.env ./scripts/release-check.js",
    "release:verify": "pnpm check:dates && pnpm check:times && pnpm check:onboarding && pnpm check:storage && pnpm check:auth-redirect && pnpm check:auth-flow && pnpm check:profile-handle && pnpm check:collections && pnpm check:chat && pnpm check:groups-notifications && pnpm check:event-creation && pnpm check:event-fetch && pnpm typecheck && pnpm lint && pnpm export:web && pnpm release:check"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "^2.110.7",
    "expo": "~57.0.21",
    "expo-calendar": "~57.0.3",
    "expo-camera": "~57.0.4",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~58.0.0",
    "expo-font": "~14.0.12",
    "expo-haptics": "~58.0.0",
    "expo-image": "~58.0.0",
    "expo-image-picker": "~58.0.0",
    "expo-linking": "~58.0.0",
    "expo-location": "~58.0.0",
    "expo-notifications": "~58.0.0",
    "expo-router": "~58.0.0",
    "expo-secure-store": "~58.0.0",
    "expo-splash-screen": "~58.0.0",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~58.0.0",
    "expo-system-ui": "~58.0.0",
    "expo-web-browser": "~58.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.87.1",
    "react-native-gesture-handler": "~3.2.1",
    "react-native-maps": "1.29.0",
    "react-native-reanimated": "~4.6.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.27.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "expo-doctor": "1.20.4",
    "typescript": "~5.9.2"
  },
  "private": true
}
